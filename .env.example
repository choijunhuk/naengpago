# Client values are public once bundled by Expo.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_AI_MODE=mock
EXPO_PUBLIC_SENTRY_DSN=

# Edge Function secrets must be configured with `supabase secrets set`.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
AI_MODE=mock
ANALYSIS_DAILY_LIMIT=30
EXPIRY_SCAN_SECRET=
SENTRY_DSN_FUNCTIONS=
